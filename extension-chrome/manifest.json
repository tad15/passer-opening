{
  "manifest_version": 3,
  "name": "Passer l'opening",
  "version": "3.8",
  "description": "Bouton « Passer l'opening » et « Passer l'ending » sur les lecteurs des sites d'animes, avec les minutages d'AniSkip.",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://graphql.anilist.co/*",
    "https://api.aniskip.com/*"
  ],
  "action": {
    "default_popup": "reglages.html",
    "default_title": "Passer l'opening",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "contenu.js"
      ]
    }
  ],
  "background": {
    "service_worker": "fond.js"
  }
}
