{
  "manifest_version": 3,
  "name": "Passer l'opening",
  "version": "3.14",
  "description": "Un bouton « Passer l'opening » sur les lecteurs vidéo d'animes, d'après les minutages publics d'AniSkip, recalés à l'oreille.",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://graphql.anilist.co/*",
    "https://api.aniskip.com/*"
  ],
  "action": {
    "default_popup": "reglages.html",
    "default_title": "Passer l'opening",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png",
      "128": "icones/icone-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "contenu.js"
      ]
    }
  ],
  "background": {
    "scripts": [
      "fond.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "passer-opening@tad15.github.io",
      "strict_min_version": "127.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  }
}
